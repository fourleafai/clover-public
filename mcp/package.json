{
  "name": "four-leaf-mcp",
  "version": "0.0.1",
  "description": "Open MCP server for interview prep. Works in ChatGPT, Claude, Cursor, and any MCP-aware client. Hands off to Four-Leaf for live voice.",
  "license": "MIT",
  "homepage": "https://github.com/fourleafai/clover-public",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fourleafai/clover-public.git",
    "directory": "mcp"
  },
  "bugs": "https://github.com/fourleafai/clover-public/issues",
  "type": "module",
  "bin": {
    "four-leaf-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "src/data",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "node --test --import tsx test/*.test.ts",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "interview-prep",
    "interview-coach",
    "job-search",
    "claude",
    "chatgpt",
    "cursor",
    "cline",
    "four-leaf"
  ]
}
